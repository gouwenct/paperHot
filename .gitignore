# Dependencies
node_modules/
.superpowers/
.agents/
.codex/

# Local secrets and machine-specific configuration
.env
.env.*
config/journal-metrics.json
config/google-scholar.json
config/web-of-science.json
config/llm.json

# Runtime logs and process files
logs/
*.log
*.pid
paperhot-server-*.log

# Generated preview/runtime state
.superpowers/**/state/

# Local work notes / obsolete handoff artifacts
tasks/
claude-fable-*.md
paperhot-handoff-*.md
paperhot-verify-*.md
paperhot-verify-*.html

# One-off local scripts that depend on private runtime configuration
scripts/backfill_google_scholar_since_may.cjs

# Local paper cache generated by refresh runs
data/papers/*
!data/papers/*.example.json

# Local user profile / research keywords
data/user/config.json
data/user/profile.json

# OS/editor noise
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
